function(gw_resolve_target_toolchain manifest_path)
  if(NOT EXISTS "${manifest_path}")
    message(FATAL_ERROR "Glyphweld target manifest is missing: ${manifest_path}")
  endif()
  file(READ "${manifest_path}" _gw_manifest)
  string(JSON _gw_name GET "${_gw_manifest}" name)
  string(JSON _gw_minimum GET "${_gw_manifest}" development_compiler minimum_version)
  string(JSON _gw_cmake_minimum GET "${_gw_manifest}" development_cmake minimum_version)
  string(JSON _gw_ninja_minimum GET "${_gw_manifest}" development_ninja minimum_version)
  string(JSON _gw_family_count LENGTH "${_gw_manifest}" development_compiler allowed_families)

  set(_gw_family_ok FALSE)
  set(_gw_families "")
  math(EXPR _gw_last "${_gw_family_count} - 1")
  foreach(_gw_index RANGE ${_gw_last})
    string(JSON _gw_family GET "${_gw_manifest}" development_compiler allowed_families ${_gw_index})
    list(APPEND _gw_families "${_gw_family}")
    if(CMAKE_C_COMPILER_ID STREQUAL _gw_family)
      set(_gw_family_ok TRUE)
    endif()
  endforeach()
  get_filename_component(_gw_compiler_real "${CMAKE_C_COMPILER}" REALPATH)
  message(STATUS "Glyphweld target pack: ${_gw_name}")
  if(CMAKE_VERSION VERSION_LESS _gw_cmake_minimum)
    message(FATAL_ERROR "Target '${_gw_name}' requires CMake ${_gw_cmake_minimum} or newer; running ${CMAKE_VERSION}.")
  endif()
  message(STATUS "Glyphweld C compiler (development-only system fallback): ${_gw_compiler_real}")
  message(STATUS "Glyphweld C compiler identification: ${CMAKE_C_COMPILER_ID}")
  message(STATUS "Glyphweld C compiler version: ${CMAKE_C_COMPILER_VERSION}")
  if(NOT _gw_family_ok)
    message(FATAL_ERROR "Target '${_gw_name}' requires one of [${_gw_families}]; CMake selected ${CMAKE_C_COMPILER_ID} at ${_gw_compiler_real}. Reconfigure with a supported compiler before enabling C.")
  endif()
  if(CMAKE_C_COMPILER_VERSION VERSION_LESS _gw_minimum)
    message(FATAL_ERROR "Target '${_gw_name}' requires ${CMAKE_C_COMPILER_ID} ${_gw_minimum} or newer; CMake selected ${CMAKE_C_COMPILER_VERSION}. Reconfigure with a supported compiler before enabling C.")
  endif()

  if(CMAKE_GENERATOR MATCHES "Ninja")
    if(NOT CMAKE_MAKE_PROGRAM)
      message(FATAL_ERROR "The Ninja generator requires a Ninja executable. Install Ninja or choose another supported generator.")
    endif()
    get_filename_component(_gw_ninja_real "${CMAKE_MAKE_PROGRAM}" REALPATH)
    execute_process(COMMAND "${CMAKE_MAKE_PROGRAM}" --version
      RESULT_VARIABLE _gw_ninja_status OUTPUT_VARIABLE _gw_ninja_version
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT _gw_ninja_status EQUAL 0)
      message(FATAL_ERROR "Selected Ninja executable cannot run: ${_gw_ninja_real}")
    endif()
    if(_gw_ninja_version VERSION_LESS _gw_ninja_minimum)
      message(FATAL_ERROR "Target '${_gw_name}' requires Ninja ${_gw_ninja_minimum} or newer; selected ${_gw_ninja_version}.")
    endif()
    message(STATUS "Glyphweld build tool (development-only system fallback): ${_gw_ninja_real} (${_gw_ninja_version})")
  elseif(GW_REQUIRE_NINJA)
    message(FATAL_ERROR "Glyphweld's documented developer command requires '-G Ninja'; active generator is '${CMAKE_GENERATOR}'. Reconfigure from a clean build directory with -G Ninja.")
  elseif(CMAKE_MAKE_PROGRAM)
    message(STATUS "Glyphweld build tool (development-only system fallback): ${CMAKE_MAKE_PROGRAM}")
  endif()
endfunction()

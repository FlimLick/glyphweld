if(NOT DEFINED GW_RUNTIME_ROOT)
  message(FATAL_ERROR "GW_RUNTIME_ROOT must point to src/runtime/.")
endif()
file(GLOB_RECURSE _gw_runtime_files "${GW_RUNTIME_ROOT}/include/*.h" "${GW_RUNTIME_ROOT}/src/*.c")
set(_gw_bad_include "#include[ \t]*[<\"][^>\"]*(X11|xcb|wayland|windows|win32|linux/|android|Cocoa|CoreFoundation|sys/|unistd|pthread|poll|select|arpa/|net/|netinet/|dlfcn|fcntl|dirent|termios|EGL|GLES|vulkan)[^>\"]*[>\"]")
set(_gw_bad_define "#[ \t]*(if|ifdef|ifndef)[^\n]*(__linux__|_WIN32|__ANDROID__|__APPLE__|__unix__|__FreeBSD__|__NetBSD__|__OpenBSD__)")
foreach(_gw_file IN LISTS _gw_runtime_files)
  file(READ "${_gw_file}" _gw_contents)
  if(_gw_contents MATCHES "${_gw_bad_include}")
    message(FATAL_ERROR "Portable runtime includes a platform header: ${_gw_file}")
  endif()
  if(_gw_contents MATCHES "${_gw_bad_define}")
    message(FATAL_ERROR "Portable runtime contains a target preprocessor branch: ${_gw_file}")
  endif()
endforeach()
message(STATUS "Portable runtime source guard passed.")

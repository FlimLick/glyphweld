if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
  message(FATAL_ERROR "EmbedBinary.cmake requires INPUT, OUTPUT, and SYMBOL.")
endif()

file(READ "${INPUT}" GW_EMBED_HEX HEX)
string(LENGTH "${GW_EMBED_HEX}" GW_EMBED_HEX_LENGTH)
if(GW_EMBED_HEX_LENGTH EQUAL 0 OR GW_EMBED_HEX_LENGTH GREATER 8589934590)
  message(FATAL_ERROR "Cannot embed '${INPUT}': unsupported byte count.")
endif()

math(EXPR GW_EMBED_BYTE_COUNT "${GW_EMBED_HEX_LENGTH} / 2")
get_filename_component(GW_EMBED_DIRECTORY "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${GW_EMBED_DIRECTORY}")
file(WRITE "${OUTPUT}" "/* Generated from ${INPUT}. Do not edit. */\n#include <stdint.h>\n\n")
file(APPEND "${OUTPUT}" "const uint8_t ${SYMBOL}[] = {\n")

set(GW_EMBED_OFFSET 0)
while(GW_EMBED_OFFSET LESS GW_EMBED_HEX_LENGTH)
  math(EXPR GW_EMBED_REMAINING "${GW_EMBED_HEX_LENGTH} - ${GW_EMBED_OFFSET}")
  if(GW_EMBED_REMAINING GREATER 128)
    set(GW_EMBED_CHUNK_LENGTH 128)
  else()
    set(GW_EMBED_CHUNK_LENGTH ${GW_EMBED_REMAINING})
  endif()
  string(SUBSTRING "${GW_EMBED_HEX}" ${GW_EMBED_OFFSET} ${GW_EMBED_CHUNK_LENGTH} GW_EMBED_CHUNK)
  string(REGEX REPLACE "([0-9a-fA-F][0-9a-fA-F])" "0x\\1U, " GW_EMBED_LINE "${GW_EMBED_CHUNK}")
  file(APPEND "${OUTPUT}" "  ${GW_EMBED_LINE}\n")
  math(EXPR GW_EMBED_OFFSET "${GW_EMBED_OFFSET} + ${GW_EMBED_CHUNK_LENGTH}")
endwhile()

file(APPEND "${OUTPUT}" "};\nconst uint32_t ${SYMBOL}_size = ${GW_EMBED_BYTE_COUNT}U;\n")

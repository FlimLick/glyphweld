file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(header "${WORK}/counter_ui.h")
set(source "${WORK}/counter_ui.c")
file(WRITE "${header}" "old-header\n")
file(WRITE "${source}" "old-source\n")
foreach(step header-write source-write header-backup source-backup header-install source-install)
  file(WRITE "${header}" "old-header\n")
  file(WRITE "${source}" "old-source\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GW_UIC_DRIVER_FAIL_STEPS=${step}" "${DRIVER}" "${PROJECT}" "${header}" "${source}" RESULT_VARIABLE code ERROR_VARIABLE error)
  if(code EQUAL 0)
    message(FATAL_ERROR "driver unexpectedly succeeded for ${step}")
  endif()
  file(READ "${header}" actual_header)
  file(READ "${source}" actual_source)
  if(NOT actual_header STREQUAL "old-header\n" OR NOT actual_source STREQUAL "old-source\n")
    message(FATAL_ERROR "driver changed output pair for ${step}: ${error}")
  endif()
  file(GLOB leftovers "${WORK}/*.gw-*")
  if(leftovers)
    message(FATAL_ERROR "driver left owned artifacts for ${step}: ${leftovers}")
  endif()
endforeach()
foreach(step source-install,header-restore source-install,source-restore)
  file(WRITE "${header}" "old-header\n")
  file(WRITE "${source}" "old-source\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GW_UIC_DRIVER_FAIL_STEPS=${step}" "${DRIVER}" "${PROJECT}" "${header}" "${source}" RESULT_VARIABLE code ERROR_VARIABLE error)
  if(code EQUAL 0)
    message(FATAL_ERROR "driver unexpectedly succeeded for ${step}")
  endif()
  if(NOT error MATCHES "preserved backup '.*\\.gw-bak-")
    message(FATAL_ERROR "driver did not report a preserved backup for ${step}: ${error}")
  endif()
  file(GLOB backups "${WORK}/*.gw-bak-*")
  if(NOT backups)
    message(FATAL_ERROR "driver removed recovery backup for ${step}")
  endif()
  file(REMOVE ${backups})
endforeach()
execute_process(COMMAND "${DRIVER}" "${WORK}/missing.json" "${header}" "${source}" RESULT_VARIABLE code)
if(code EQUAL 0)
  message(FATAL_ERROR "driver unexpectedly accepted missing input")
endif()
